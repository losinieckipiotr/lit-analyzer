{
	"name": "web-component-analyzer",
	"version": "3.0.9",
	"description": "CLI that analyzes web components",
	"module": "lib/esm/api.js",
	"types": "lib/esm/api.d.ts",
	"main": "lib/cjs/api.js",
	"files": [
		"/lib/"
	],
	"exports": {
		".": "./lib/esm/api.js",
		"./is-assignable-to-type.js": "./lib/esm/is-assignable-to-type.js",
		"./simple-type.js": "./lib/esm/simple-type.js"
	},
	"scripts": {
		"build": "wireit",
		"build:test": "wireit",
		"watch": "rollup -c --watch",
		"pretest": "cd dev && npm i",
		"test": "wireit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test:update": "ava --update-snapshots",
		"test:watch": "ava --watch",
		"prettier:check": "prettier --check \"src/**/*.{ts,tsx}\"",
		"prettier:write": "prettier --write \"src/**/*.{ts,tsx}\"",
		"tsc": "wireit",
		"tsc:test": "wireit",
		"tsc:watch": "wireit"
	},
	"wireit": {
		"build:test": {
			"command": "tsc --project test/tsconfig.json"
		},
		"copy-test-files": {
			"command": "node ./scripts/copy-test-files.ts"
		},
		"build": {
			"clean": true,
			"command": "rollup -c",
			"output": [
				"lib"
			]
		},
		"test": {
			"dependencies": [
				"build:test",
				"copy-test-files"
			],
			"command": "ava -s --fail-fast --color",
			"files": [
				"**/test/**/*.js",
				"package.json"
			]
		},
		"tsc": {
			"command": "tsc --noEmit",
			"files": [
				"src/**/*",
				"tsconfig.json"
			]
		},
		"tsc:test": {
			"command": "tsc --noEmit -p test/tsconfig.json",
			"files": [
				"test/**/*",
				"test/tsconfig.json"
			]
		},
		"tsc:watch": {
			"service": true,
			"command": "tsc --noEmit --watch",
			"files": [
				"src/**/*",
				"tsconfig.json"
			]
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/runem/web-component-analyzer.git"
	},
	"keywords": [
		"web components",
		"web",
		"components"
	],
	"contributors": [
		{
			"name": "Rune Mehlsen",
			"url": "https://github.com/runem",
			"img": "https://avatars0.githubusercontent.com/u/5372940?s=400&u=43d97899257af3c47715679512919eadb07eab26&v=4"
		}
	],
	"author": "Rune Mehlsen",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/runem/web-component-analyzer/issues"
	},
	"homepage": "https://github.com/runem/web-component-analyzer#readme",
	"dependencies": {
		"fast-glob": "^3.3.3",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/node": "^26.3.0",
		"@types/yargs": "^17.0.35",
		"ava": "^8.0.1",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"rollup": "^4.62.5",
		"rollup-plugin-copy": "^3.5.0",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.67.0",
		"wireit": "^0.14.13"
	},
	"peerDependencies": {
		"typescript": "6.0.3"
	},
	"ava": {
		"cache": true,
		"timeout": "2m",
		"extensions": [
			"js"
		],
		"snapshotDir": "test/snapshots/results",
		"files": [
			"dist/test/**/*.js",
			"!dist/test/{helpers,snapshots}/**/*",
			"!dist/test/flavors/lwc/comp"
		]
	},
	"bin": {
		"wca": "cli.js",
		"web-component-analyzer": "cli.js"
	}
}
