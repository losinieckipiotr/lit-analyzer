{
  "name": "lit-analyzer",
  "version": "3.0.6",
  "description": "CLI that type checks bindings in lit-html templates",
  "author": "runem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/runem/lit-analyzer.git"
  },
  "keywords": [
    "lit-html",
    "lit",
    "lit-element",
    "javascript",
    "typescript",
    "web components",
    "web",
    "components",
    "tagged",
    "template"
  ],
  "scripts": {
    "build": "wireit",
    "build:test": "wireit",
    "prepublishOnly": "npm test",
    "tsc": "wireit",
    "tsc:watch": "wireit",
    "test": "wireit",
    "test:all": "wireit"
  },
  "wireit": {
    "tsc": {
      "command": "tsc --noEmit --pretty"
    },
    "tsc:watch": {
      "command": "tsc --noEmit --watch --pretty"
    },
    "build": {
      "command": "tsc",
      "clean": true,
      "output": [
        "dist"
      ]
    },
    "build:test": {
      "clean": true,
      "command": "tsc -p tsconfig-test.json",
      "files": [
        "src/**/*.ts",
        "package.json",
        "tsconfig.json"
      ],
      "output": [
        "out"
      ]
    },
    "test": {
      "dependencies": [
        "build",
        "build:test"
      ],
      "env": {
        "#comment": "TsModuleKind from `/src/test/helpers/ts-test.ts`",
        "TS_MODULE": "current"
      },
      "command": "ava --color"
    },
    "test:all": {
      "#comment": "same as test but when env is not set all versions will be tested",
      "dependencies": [
        "build"
      ],
      "command": "ava --color"
    }
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "files": [
    "dist/lib",
    "dist/web-component-analyzer",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "cli.js"
  ],
  "bin": {
    "lit-analyzer": "cli.js"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "didyoumean2": "^7.0.4",
    "fast-glob": "^3.2.11",
    "parse5": "^8.0.1",
    "typescript": "6.0.3",
    "vscode-css-languageservice": "^6.3.10",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/yargs": "^17.0.35",
    "ava": "^8.0.1",
    "lit": "^3.3.3",
    "tslib": "^2.0.0",
    "typescript-5.2": "npm:typescript@5.2.2",
    "typescript-5.9": "npm:typescript@5.9.3",
    "wireit": "^0.14.13"
  },
  "ava": {
    "cache": false,
    "timeout": "200s",
    "extensions": [
      "js"
    ],
    "snapshotDir": "out/test/snapshots/results",
    "files": [
      "out/test/**/*.js",
      "!out/test/helpers/**/*"
    ]
  },
  "contributors": [
    {
      "name": "Rune Mehlsen",
      "url": "https://twitter.com/runemehlsen",
      "img": "https://avatars2.githubusercontent.com/u/5372940?s=460&v=4"
    },
    {
      "name": "Andreas Mehlsen",
      "url": "https://twitter.com/andreasmehlsen",
      "img": "https://avatars1.githubusercontent.com/u/6267397?s=460&v=4"
    },
    {
      "name": "You?",
      "img": "https://joeschmoe.io/api/v1/random",
      "url": "https://github.com/runem/lit-analyzer/blob/master/CONTRIBUTING.md"
    }
  ]
}
