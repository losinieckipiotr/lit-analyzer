{
  "extends": "../../tsconfig.json",
  "include": ["src"],
  "exclude": ["src/web-component-analyzer/dev", "src/web-component-analyzer/scripts", "src/web-component-analyzer/test"],
  "compilerOptions": {
    "types": ["node", "yargs"],
    "lib": ["ESNext"],
    "module": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "resolveJsonModule": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
  },
}
