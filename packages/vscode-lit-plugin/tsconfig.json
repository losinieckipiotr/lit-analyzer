{
  "extends": "../../tsconfig.json",
  "include": ["./src"],
  "exclude": ["node_modules", "./src/test/fixtures"],
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "outDir": "./out",
    "lib": ["ES2024"],
    "rootDir": "src",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "types": ["mocha", "node"],
    "esModuleInterop": true,
    "noEmit": false,
    "inlineSourceMap": true
  }
}
