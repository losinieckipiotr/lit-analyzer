// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Extension Tests",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/built",
				"--extensionTestsPath=${workspaceFolder}/out/test/scripts/mocha-driver.js",
				"--no-sandbox",
				"--disable-gpu-sandbox",
				"--disable-updates",
				"--skip-welcome",
				"--skip-release-notes",
				"--no-cached-data",
				"--disable-workspace-trust"
		],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/out/**/*.js", "${workspaceFolder}/built/**/*.js"],
		}
	]
}
