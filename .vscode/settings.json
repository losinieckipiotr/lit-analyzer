{
	// "js/ts.tsdk.path": "node_modules/typescript/lib",
	"editor.wordWrapColumn": 80,
	"editor.rulers": [
		{
			"column": 80
		}
	],
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports": "always"
	},
	"search.exclude": {
		"packages/*/lib": true,
		"packages/*/out": true,
		"packages/*/built": true,
		"packages/*/dist": true
	}
}
